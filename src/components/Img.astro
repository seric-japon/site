---
// Cover image that fills its (positioned) container. Mirrors the old Placeholder
// API so real photos can drop in where stripe placeholders used to sit.
interface Props {
  src: string;
  alt: string;
  class?: string;
  /** Eager + high priority for above-the-fold hero images. */
  eager?: boolean;
  /** object-position, e.g. "center", "center 30%". */
  position?: string;
}
const {
  src,
  alt,
  class: className = "",
  eager = false,
  position = "center",
} = Astro.props;
---
<img
  src={src}
  alt={alt}
  class={`seric-img ${className}`}
  loading={eager ? "eager" : "lazy"}
  decoding="async"
  fetchpriority={eager ? "high" : "auto"}
  style={`object-position:${position};`}
/>

<style>
  .seric-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
