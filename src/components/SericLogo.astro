---
// Real SÉRIC wordmark — Pantone 277 U knockout on transparent background.
// Works on both the dark hero (transparent nav) and the white nav.
interface Props {
  size?: "sm" | "md" | "lg";
  href?: string;
  /** kept for backwards-compat with existing call sites; no longer used. */
  tone?: "blue" | "inverse" | "outline";
}
const { size = "md", href = "/" } = Astro.props;

const heights = { sm: "22px", md: "30px", lg: "42px" } as const;
const h = heights[size];
---
<a href={href} class="seric-logo" aria-label="SÉRIC, accueil">
  <img src="/images/seric-logo.png" alt="SÉRIC" style={`height:${h};`} />
</a>

<style>
  .seric-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 0;
  }
  .seric-logo img {
    width: auto;
    display: block;
  }
</style>
