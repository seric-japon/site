---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const stats = [
  { val: "45",   label: t("stat_45y_label") },
  { val: "38",   label: t("stat_26y_label") },
  { val: "2",    label: t("stat_offices")   },
  { val: "120+", label: t("stat_clients")   },
];
---
<section class="stats" data-reveal-stagger>
  <div class="wrap">
    {stats.map((s) => (
      <div class="stat">
        <div class="stat-val">{s.val}</div>
        <div class="stat-label">{s.label}</div>
      </div>
    ))}
  </div>
</section>

<style>
  .stats {
    background: #071629;
    color: #fff;
    padding: 100px 56px;
  }
  .wrap {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }
  .stat {
    padding: 0 36px;
    border-left: 1px solid rgba(255, 255, 255, 0.10);
  }
  .stat:first-child { border-left: none; }
  .stat-val {
    font-size: 84px;
    line-height: 1;
    font-weight: 300;
    letter-spacing: -0.04em;
    color: #a6c4e4;
    margin-bottom: 16px;
  }
  .stat-label {
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.68);
    font-weight: 500;
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .stats { padding: 60px 24px; }
    .wrap { grid-template-columns: repeat(2, 1fr); gap: 40px 24px; }
    .stat { padding: 0; border-left: none; }
    .stat-val { font-size: 56px; }
  }
</style>
