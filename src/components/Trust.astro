---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

// Chaque entrée : `name` (repli texte + alt de l'image) et `src` optionnel.
// Tant que `src` est vide, le placeholder texte s'affiche. Dès qu'un vrai
// logo est déposé dans public/images/logos/, renseigner `src` pour l'afficher.
// `tall` : marques au logo carré (ex. GEFCO), affichées un peu plus hautes
// pour rester lisibles à côté des wordmarks horizontaux.
const logos: { name: string; src?: string; tall?: boolean }[] = [
  { name: "Dassault Aviation", src: "/images/logos/dassault-aviation.svg" },
  { name: "Veolia", src: "/images/logos/veolia.svg" },
  { name: "Forvia", src: "/images/logos/forvia.svg" },
  { name: "Airbus", src: "/images/logos/airbus.svg" },
  { name: "Total", src: "/images/logos/total.svg" },
  { name: "Colas", src: "/images/logos/colas.png" },
  { name: "Gefco", src: "/images/logos/gefco.svg", tall: true },
  { name: "Bleistahl", src: "/images/logos/bleistahl.webp" },
];
---
<section class="trust">
  <div class="wrap">
    <div class="header">
      <div class="eyebrow">
        <span class="rule" />
        {t("trust_title")}
      </div>
    </div>

    <div class="grid" data-reveal-stagger>
      {logos.map((l) => (
        <div class="cell">
          {l.src
            ? <img src={l.src} alt={l.name} loading="lazy" class:list={[{ tall: l.tall }]} />
            : <span class="ph">[ {l.name} ]</span>}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .trust {
    background: #fff;
    padding: 100px 56px;
    border-top: 1px solid rgba(11, 34, 64, 0.12);
  }
  .wrap { max-width: 1320px; margin: 0 auto; }
  .header { margin-bottom: 56px; }
  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #6b95c4;
    font-weight: 600;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .rule { width: 28px; height: 1px; background: #6b95c4; }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid rgba(11, 34, 64, 0.12);
    border-left: 1px solid rgba(11, 34, 64, 0.12);
  }
  .cell {
    height: 130px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    border-right: 1px solid rgba(11, 34, 64, 0.12);
    border-bottom: 1px solid rgba(11, 34, 64, 0.12);
    transition: background 0.25s;
  }
  .cell:hover { background: #fbfaf7; }

  /* Repli texte tant qu'aucune image n'est fournie */
  .ph {
    color: rgba(11, 34, 64, 0.35);
    font-size: 11px;
    letter-spacing: 0.18em;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-weight: 500;
    transition: color 0.25s;
  }
  .cell:hover .ph { color: #0a1a2e; }

  /* Vrais logos : N&B discret, couleur au survol (sobre, premium) */
  .cell img {
    max-width: 100%;
    max-height: 56px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.6;
    transition: filter 0.25s, opacity 0.25s;
  }
  .cell:hover img {
    filter: grayscale(0);
    opacity: 1;
  }
  .cell img.tall { max-height: 82px; }

  @media (max-width: 900px) {
    .trust { padding: 60px 24px; }
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
