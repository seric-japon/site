---
import type { Lang } from "../../i18n/ui";
import { useTranslations, isCJK } from "../../i18n/utils";
import Nav from "../Nav.astro";
import PageHero from "../PageHero.astro";
import Footer from "../Footer.astro";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const EMAIL = "information@seric-japon.com";
// Coordonnées exactes des bâtiments (géocodées sur le bâtiment, pas sur
// l'adresse postale, pour que le marqueur tombe pile sur l'immeuble) :
// Tokyo = 日本橋一丁目三井ビルディング, Séoul = 용성비즈텔.
const mapUrl = (lat: number, lng: number) =>
  `https://maps.google.com/maps?q=${lat},${lng}&z=17&hl=${lang}&output=embed`;
const offices = [
  {
    name: t("con_tokyo"),
    addr: t("con_tokyo_addr"),
    access: t("con_tokyo_access"),
    phone: "+81 3-5542-1856",
    map: mapUrl(35.6825593, 139.7746312),
  },
  {
    name: t("con_seoul"),
    addr: t("con_seoul_addr"),
    access: "",
    phone: "+82 2-730-2740",
    map: mapUrl(37.5299841, 126.9681752),
  },
];
const titleSize = isCJK(lang) ? "44px" : "52px";
---
<div class="seric-premium">
  <Nav lang={lang} path="/contact" />
  <PageHero
    eyebrow={t("nav_contact")}
    title={t("con_hero_title")}
    sub={t("con_hero_sub")}
    image="/images/tokyo-night.jpg"
    alt="Tokyo de nuit"
    position="center"
    titleSize={titleSize}
  />

  <section class="offices">
    <div class="wrap">
      <h2 class="sec-title">{t("con_offices_title")}</h2>
      <div class="grid">
        {offices.map((o) => (
          <article class="office" data-reveal>
            <div class="media">
              <iframe
                src={o.map}
                title={o.name}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              ></iframe>
            </div>
            <div class="body">
              <h3>{o.name}</h3>
              <p class="addr">{o.addr}</p>
              {o.access && <p class="access">{o.access}</p>}
              <dl>
                <div>
                  <dt>{t("con_phone_label")}</dt>
                  <dd><a href={`tel:${o.phone.replace(/[^+\d]/g, "")}`}>{o.phone}</a></dd>
                </div>
                <div>
                  <dt>{t("con_email_label")}</dt>
                  <dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
                </div>
              </dl>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="form-band" id="contact-form">
    <div class="wrap">
      <div class="form-head">
        <div class="eyebrow"><span class="rule" />{t("nav_contact")}</div>
        <h2>{t("con_form_title")}</h2>
        <p>{t("con_form_intro")}</p>
      </div>
      <form
        class="form"
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="bot-field" aria-hidden="true">
          <label>Ne pas remplir <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>
        <div class="field-row">
          <label class="field">
            <span>{t("form_first")}</span>
            <input type="text" name="prenom" autocomplete="given-name" required />
          </label>
          <label class="field">
            <span>{t("form_last")}</span>
            <input type="text" name="nom" autocomplete="family-name" required />
          </label>
        </div>
        <div class="field-row">
          <label class="field">
            <span>{t("form_email")}</span>
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <label class="field">
            <span>{t("form_company")}</span>
            <input type="text" name="societe" autocomplete="organization" />
          </label>
        </div>
        <label class="field">
          <span>{t("form_message")}</span>
          <textarea name="message" rows="5" required></textarea>
        </label>
        <div class="form-foot">
          <p class="note">{t("form_note")}</p>
          <button type="submit">{t("form_send")} <span>→</span></button>
        </div>
        <p
          class="form-status"
          data-form-status
          data-success={t("form_success")}
          data-error={t("form_error")}
          hidden
        ></p>
      </form>
    </div>
  </section>

  <Footer lang={lang} />
</div>

<style>
  .wrap { max-width: 1320px; margin: 0 auto; }

  /* Offices */
  .offices { background: #fbfaf7; padding: 120px 56px; }
  .sec-title { font-size: 14px; letter-spacing: 0.18em; text-transform: uppercase; color: #6b95c4; font-weight: 600; margin: 0 0 56px; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .office { background: #fff; border: 1px solid rgba(11,34,64,0.10); display: flex; flex-direction: column; }
  .media { height: 260px; overflow: hidden; background: #e8e4dc; }
  .media iframe { width: 100%; height: 100%; border: 0; display: block; filter: grayscale(0.2) contrast(1.05); }
  .body { padding: 36px 40px 40px; }
  .body h3 { font-size: 24px; font-weight: 600; margin: 0 0 18px; color: #0a1a2e; }
  .addr { white-space: pre-line; font-size: 15px; line-height: 1.7; color: rgba(11,34,64,0.74); margin: 0 0 16px; }
  .access { font-size: 14px; line-height: 1.6; color: rgba(11,34,64,0.56); margin: 0 0 24px; }
  dl { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 0; padding-top: 22px; border-top: 1px solid rgba(11,34,64,0.10); }
  dt { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #6b95c4; font-weight: 600; margin-bottom: 6px; }
  dd { margin: 0; font-size: 14px; }
  dd a { color: #0a1a2e; text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.2s; }
  dd a:hover { border-bottom-color: #6b95c4; }

  /* Form */
  .form-band { background: #071629; color: #fff; padding: 120px 56px; }
  .form-head { max-width: 640px; margin: 0 auto 56px; text-align: center; }
  .form-head .eyebrow { justify-content: center; display: flex; align-items: center; gap: 12px; font-size: 12px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #a6c4e4; margin-bottom: 24px; }
  .rule { width: 28px; height: 1px; background: #a6c4e4; }
  .form-head h2 { font-size: 38px; font-weight: 500; letter-spacing: -0.02em; margin: 0 0 16px; }
  .form-head p { font-size: 18px; color: rgba(255,255,255,0.7); font-weight: 300; margin: 0; }
  .form { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 22px; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .field { display: flex; flex-direction: column; gap: 10px; }
  .field > span { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.6); font-weight: 600; }
  .field input, .field textarea {
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.16);
    color: #fff; font-family: inherit; font-size: 15px; padding: 14px 16px; border-radius: 0;
    transition: border-color 0.2s, background 0.2s; resize: vertical;
  }
  .field input:focus, .field textarea:focus {
    outline: none; border-color: #a6c4e4; background: rgba(166,196,228,0.06);
  }
  .form-foot { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-top: 8px; }
  .note { font-size: 12px; color: rgba(255,255,255,0.5); margin: 0; max-width: 420px; line-height: 1.6; }
  .form-foot button {
    background: #a6c4e4; color: #0b2240; border: none; cursor: pointer;
    font-family: inherit; font-size: 13px; font-weight: 600; letter-spacing: 0.08em;
    text-transform: uppercase; padding: 16px 32px; display: inline-flex; align-items: center; gap: 12px;
    transition: background 0.25s;
  }
  .form-foot button:hover { background: #fff; }
  .form-foot button:disabled { opacity: 0.6; cursor: default; }
  .bot-field { position: absolute; left: -9999px; margin: 0; }
  .form { position: relative; }
  .form-status {
    margin: 0; font-size: 15px; line-height: 1.6; padding: 14px 18px;
    background: rgba(166,196,228,0.12); border: 1px solid rgba(166,196,228,0.4); color: #d9e6f4;
  }
  .form-status.is-error {
    background: rgba(228,166,166,0.10); border-color: rgba(228,166,166,0.4); color: #f0d9d9;
  }

  @media (max-width: 900px) {
    .offices, .form-band { padding: 72px 24px; }
    .grid { grid-template-columns: 1fr; gap: 32px; }
    .field-row { grid-template-columns: 1fr; }
    .form-head h2 { font-size: 28px; }
  }
</style>

<script>
  // Soumission AJAX vers Netlify Forms — le visiteur reste sur la page,
  // confirmation localisée via data-success / data-error.
  const form = document.querySelector<HTMLFormElement>('form[name="contact"]');
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>("[data-form-status]");
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      try {
        const body = new URLSearchParams(
          new FormData(form) as unknown as Record<string, string>
        ).toString();
        const res = await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body,
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        if (status) {
          status.textContent = status.dataset.success ?? "";
          status.classList.remove("is-error");
          status.hidden = false;
        }
      } catch {
        if (status) {
          status.textContent = status.dataset.error ?? "";
          status.classList.add("is-error");
          status.hidden = false;
        }
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>
