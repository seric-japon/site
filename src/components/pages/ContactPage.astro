---
// Page Contact = le formulaire, et rien d'autre.
// Tout ce qui sert à VENIR — cartes, coordonnées des bureaux, sorties de
// métro, fiches imprimables — vit sur `/acces` (AccesPage) : deux intentions
// différentes, deux pages. Le pied de page rappelle les deux adresses et les
// deux téléphones sur les 24 pages, donc rien ne se perd ici.
import type { Lang } from "../../i18n/ui";
import { useTranslations, isCJK } from "../../i18n/utils";
import Nav from "../Nav.astro";
import PageHero from "../PageHero.astro";
import Footer from "../Footer.astro";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const titleSize = isCJK(lang) ? "44px" : "52px";
---
<div class="seric-premium">
  <Nav lang={lang} path="/contact" />
  <!-- Le bandeau porte tout l'intitulé de la page (demande client du
       2026-09-15) : « Contact » / « Écrivez-nous » / les équipes sont à votre
       écoute. Le formulaire suit directement, sans en-tête à lui — sinon les
       trois mêmes lignes seraient écrites deux fois à 200 px d'intervalle. -->
  <PageHero
    eyebrow={t("nav_contact")}
    title={t("con_form_title")}
    sub={t("con_form_intro")}
    image="/images/tokyo-night.jpg"
    alt="Tokyo de nuit"
    position="center"
    titleSize={titleSize}
  />

  <section class="form-band" id="contact-form">
    <div class="wrap">
      <form
        class="form"
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="bot-field" aria-hidden="true">
          <label>Ne pas remplir <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>
        <div class="field-row">
          <label class="field">
            <span>{t("form_first")}</span>
            <input type="text" name="prenom" autocomplete="given-name" required />
          </label>
          <label class="field">
            <span>{t("form_last")}</span>
            <input type="text" name="nom" autocomplete="family-name" required />
          </label>
        </div>
        <div class="field-row">
          <label class="field">
            <span>{t("form_email")}</span>
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <label class="field">
            <span>{t("form_company")}</span>
            <input type="text" name="societe" autocomplete="organization" />
          </label>
        </div>
        <label class="field">
          <span>{t("form_message")}</span>
          <textarea name="message" rows="5" required></textarea>
        </label>
        <div class="form-foot">
          <p class="note">{t("form_note")}</p>
          <button type="submit">{t("form_send")} <span>→</span></button>
        </div>
        <p
          class="form-status"
          data-form-status
          data-success={t("form_success")}
          data-error={t("form_error")}
          hidden
        ></p>
      </form>
    </div>
  </section>

  <Footer lang={lang} />
</div>

<style>
  .wrap { max-width: 1320px; margin: 0 auto; }

  /* Form */
  .form-band { background: #071629; color: #fff; padding: 96px 56px 120px; }
  .form { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 22px; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .field { display: flex; flex-direction: column; gap: 10px; }
  .field > span { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.6); font-weight: 600; }
  .field input, .field textarea {
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.16);
    color: #fff; font-family: inherit; font-size: 15px; padding: 14px 16px; border-radius: 0;
    transition: border-color 0.2s, background 0.2s; resize: vertical;
  }
  .field input:focus, .field textarea:focus {
    outline: none; border-color: #a6c4e4; background: rgba(166,196,228,0.06);
  }
  .form-foot { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-top: 8px; }
  .note { font-size: 12px; color: rgba(255,255,255,0.5); margin: 0; max-width: 420px; line-height: 1.6; }
  .form-foot button {
    background: #a6c4e4; color: #0b2240; border: none; cursor: pointer;
    font-family: inherit; font-size: 13px; font-weight: 600; letter-spacing: 0.08em;
    text-transform: uppercase; padding: 16px 32px; display: inline-flex; align-items: center; gap: 12px;
    transition: background 0.25s;
  }
  .form-foot button:hover { background: #fff; }
  .form-foot button:disabled { opacity: 0.6; cursor: default; }
  .bot-field { position: absolute; left: -9999px; margin: 0; }
  .form { position: relative; }
  .form-status {
    margin: 0; font-size: 15px; line-height: 1.6; padding: 14px 18px;
    background: rgba(166,196,228,0.12); border: 1px solid rgba(166,196,228,0.4); color: #d9e6f4;
  }
  .form-status.is-error {
    background: rgba(228,166,166,0.10); border-color: rgba(228,166,166,0.4); color: #f0d9d9;
  }

  @media (max-width: 900px) {
    .form-band { padding: 64px 24px 72px; }
    .field-row { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Soumission AJAX vers Netlify Forms — le visiteur reste sur la page,
  // confirmation localisée via data-success / data-error.
  const form = document.querySelector<HTMLFormElement>('form[name="contact"]');
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>("[data-form-status]");
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      try {
        const body = new URLSearchParams(
          new FormData(form) as unknown as Record<string, string>
        ).toString();
        const res = await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body,
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        if (status) {
          status.textContent = status.dataset.success ?? "";
          status.classList.remove("is-error");
          status.hidden = false;
        }
      } catch {
        if (status) {
          status.textContent = status.dataset.error ?? "";
          status.classList.add("is-error");
          status.hidden = false;
        }
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>
