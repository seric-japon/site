---
import "../styles/global.css";
import type { Lang } from "../i18n/ui";
import { ogLocale, localeAlternates } from "../i18n/utils";
import CookieBanner from "../components/CookieBanner.astro";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Locale-agnostic path of this page (e.g. "/", "/contact"). Drives hreflang. */
  path?: string;
  /** Absolute or root-relative URL of the social-share image (1200×630). */
  ogImage?: string;
}
const { lang, title, description, path = "/", ogImage } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const alternates = localeAlternates(Astro.site, path);
const ogImageUrl = ogImage
  ? new URL(ogImage, Astro.site).href
  : undefined;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SÉRIC" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {alternates
      .filter((a) => a.lang !== lang)
      .map((a) => (
        <meta property="og:locale:alternate" content={ogLocale[a.lang]} />
      ))}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    {/* Twitter */}
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Sans+JP:wght@300;400;500;600;700&family=Noto+Sans+KR:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
    <CookieBanner lang={lang} />
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
