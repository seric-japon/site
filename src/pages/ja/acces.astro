---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AccesPage from "../../components/pages/AccesPage.astro";
import { useTranslations } from "../../i18n/utils";

const lang = "ja" as const;
const t = useTranslations(lang);
---
<BaseLayout
  lang={lang}
  title={t("acces_meta_title")}
  description={t("acces_meta_desc")}
  path="/acces"
>
  <AccesPage lang={lang} />
</BaseLayout>
